# ============================================================================
# Database-Driven LLM Wiki — environment template (NFR-01: no secrets in source).
#
#   cp env/.env.example env/.env      # then fill the blanks; env/.env is gitignored
#
# Every value below is a PLACEHOLDER. The real env/.env file is never committed.
# ============================================================================

# ---- Oracle ----------------------------------------------------------------
# Password for SYS/SYSTEM/PDBADMIN in the Oracle Free container.
ORACLE_PWD=changeme_oracle_pwd
# ODP.NET connection string used by LlmWiki.Infrastructure. The local Docker DB
# exposes the FREEPDB1 service on 1521; app schema user is 'llmwiki'.
ORACLE_CONNECTION_STRING=User Id=llmwiki;Password=Wiki_Dev_0;Data Source=localhost:1521/FREEPDB1;

# ---- Embeddings (Ollama) ---------------------------------------------------
OLLAMA_ENDPOINT=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ---- Chat (provider via Semantic Kernel) -----------------------------------
# CHAT_PROVIDER selects the SK connector wiring: 'openai' (default), 'anthropic'
# (drop-in via its OpenAI-compatible endpoint), or 'ollama' (local, no API key).
# Only the key for the selected hosted provider needs a value. For 'ollama', set
# CHAT_MODEL to a pulled model and leave CHAT_ENDPOINT blank for the local server
# (http://localhost:11434/v1/).
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
CHAT_ENDPOINT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- API base URL (consumed by the Expo app) -------------------------------
API_BASE_URL=http://localhost:5080

# ---- Wiki file store -------------------------------------------------------
WIKI_ROOT=wiki
